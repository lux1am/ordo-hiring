# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.

# --- Обязательные ---------------------------------------------------------
# Ключ Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Ключ сервисного аккаунта Google — весь файл JSON одной строкой.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ID таблицы из её адреса:
# docs.google.com/spreadsheets/d/ЭТА_ЧАСТЬ/edit
SHEET_ID=

# --- Необязательные -------------------------------------------------------
WORKSHEET_NAME=Данные
TZ_OFFSET_HOURS=3
LOG_LEVEL=INFO

# Модели
SCORER_MODEL=claude-sonnet-4-6

# Пороги проверок
PASTE_PCT_THRESHOLD=30
SPEED_CPM_THRESHOLD_DESKTOP=400
SPEED_CPM_THRESHOLD_MOBILE=700
SUSPICIOUS_MIN_LENGTH=400
TAB_AWAY_SECONDS_THRESHOLD=60
MATH_TOLERANCE=0.10
CONVERSION_OUTLIER_THRESHOLD=50
AI_STYLE_DOWNGRADE_THRESHOLD=70
EVIDENCE_MAX_WORDS=15
Q1_MIN_CONFIRMED_MONTHS=2

# Пороги вердикта
VERDICT_A_MIN=12
VERDICT_B_MIN=9

# Антиспам и надёжность
RATE_LIMIT_PER_HOUR=5
HONEYPOT_FIELD=company_website
API_RETRY_DELAYS=2,8,30
STUCK_SCAN_INTERVAL_SEC=300
STUCK_TIMEOUT_SEC=600
